# ---------------------------------------------------------------------------
# Terraform state contains SECRETS IN PLAINTEXT — storage keys, connection
# strings, generated passwords. It must never reach a git repository, even a
# private one. This is the single most common way credentials leak out of an
# IaC project.
# ---------------------------------------------------------------------------
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Provider binaries and lock dirs — hundreds of MB, regenerated by init.
**/.terraform/*
.terraform.lock.hcl.bak

# Plan files. A saved plan embeds variable values, including sensitive ones.
*.tfplan
tfplan
plan.out

# Local variable files. sandbox.tfvars IS committed deliberately — it holds
# only a subscription GUID and a resource group name, no credentials — but
# anything a person creates locally is not.
*.auto.tfvars
terraform.tfvars
!sandbox.tfvars

# Azure CLI / service principal credentials, in case anyone ever writes them
# to a file "just for a minute".
*.pem
*.pfx
*credentials*.json
sp.json

# Test output. Evidence belongs in the findings report, not in git history,
# and the logs contain hostnames and IPs.
evidence/*
!evidence/README.md
bypass-test-*.log
exception-validation-*.log
intended.json
actual.json

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
